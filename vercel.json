{
  "framework": null,
  "installCommand": "true",
  "buildCommand": "true",
  "outputDirectory": "storefront",
  "routes": [
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/checkout/?$", "dest": "/checkout.html" },
    { "src": "^/(buy|signup)/?$", "status": 308, "headers": { "Location": "/checkout" } },
    { "src": "^/(nova\\.css|checkout\\.js|favicon\\.svg|robots\\.txt)$", "dest": "/$1" },
    { "src": "^/public/status$", "dest": "https://nova-evolution-v4.vercel.app/public/status", "methods": ["GET", "HEAD"] },
    { "src": "^/signup/checkout$", "dest": "https://nova-evolution-v4.vercel.app/signup/checkout", "methods": ["POST"] },
    { "src": "^/signup/(complete|cancel)$", "dest": "/checkout.html" },
    { "src": "^/(blog|guides)(/.*)?$", "status": 410 },
    { "src": "^/.*$", "status": 404 }
  ],
  "git": { "deploymentEnabled": { "main": true, "versions/v3-agent-network": false, "versions/v4-nova": false } }
}
