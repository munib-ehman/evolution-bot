# Load this file in a process manager or shell. Never commit real values.
NOVA_DB=data/nova.sqlite
NOVA_ADMIN_TOKEN=
NOVA_AI_BASE_URL=https://api.openai.com/v1
NOVA_AI_KEY=
NOVA_AI_MODEL=
NOVA_TRANSCRIPTION_MODEL=
META_APP_SECRET=
META_GRAPH_VERSION=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_REPORT_TEMPLATE=
WHATSAPP_REPORT_LANGUAGE=en_US
NOVA_PUBLIC_URL=
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
NOVA_CALL_BUSINESS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOVA_TOKEN_ENCRYPTION_KEY=

# Hosted $200/month subscription. Stripe account/price must already be configured.
NOVA_STRIPE_SECRET_KEY=
NOVA_STRIPE_WEBHOOK_SECRET=
NOVA_STRIPE_PRICE_ID=
NOVA_STRIPE_SUCCESS_URL=
NOVA_STRIPE_CANCEL_URL=
# Shared Nova contact; merchant customer numbers are connected separately.
NOVA_WHATSAPP_PHONE_ID=
WHATSAPP_WELCOME_TEMPLATE=
WHATSAPP_WELCOME_LANGUAGE=en_US
# Approved owner calls. These are ordinary telephone calls through Twilio.
NOVA_CALL_FROM_NUMBER=
# Optional lower-cost customer model; use its own verified rates below.
NOVA_CUSTOMER_AI_MODEL=
NOVA_INPUT_USD_PER_MILLION=
NOVA_OUTPUT_USD_PER_MILLION=
NOVA_CUSTOMER_INPUT_USD_PER_MILLION=
NOVA_CUSTOMER_OUTPUT_USD_PER_MILLION=

# Open checkout only after the live provider flow is verified.
NOVA_ACCEPT_SIGNUPS=false
