# ─────────────────────────────────────────────────────────────────────────────
# LLM "brain" configuration (OPTIONAL).
#
# Leave ALL of these blank/unset to run in MOCK MODE — the app fully works with
# rule-based answers built from products.json. Zero key, zero cost, zero signup.
#
# To upgrade to a real LLM, copy this file to `.env` and fill in a FREE-TIER
# OpenAI-compatible provider. The values below are commented examples — pick ONE.
# `.env` is git-ignored so your key never gets committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Option A: Groq (free tier, very fast) — https://console.groq.com/keys ──────
# VITE_LLM_BASE_URL=https://api.groq.com/openai/v1
# VITE_LLM_API_KEY=gsk_your_free_key_here
# VITE_LLM_MODEL=llama-3.3-70b-versatile

# ── Option B: OpenRouter (has free models) — https://openrouter.ai/keys ────────
# VITE_LLM_BASE_URL=https://openrouter.ai/api/v1
# VITE_LLM_API_KEY=sk-or-your_free_key_here
# VITE_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Option C: Google Gemini (free tier, OpenAI-compatible endpoint) ────────────
# Get a key at https://aistudio.google.com/apikey
# VITE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# VITE_LLM_API_KEY=your_free_gemini_key_here
# VITE_LLM_MODEL=gemini-2.0-flash

# ── Option D: Self-hosted / local (Ollama, LM Studio, llama.cpp) — $0 forever ──
# VITE_LLM_BASE_URL=http://localhost:11434/v1
# VITE_LLM_API_KEY=ollama
# VITE_LLM_MODEL=llama3.2

# ─────────────────────────────────────────────────────────────────────────────
# Magic-link login gate (OPTIONAL) — lead capture via Supabase (free tier).
#
# Leave unset and the app is wide open (no login). To require an email
# magic-link sign-in before anyone can use the app:
#   1. Create a free project at https://supabase.com/dashboard
#   2. Project Settings → API → copy the Project URL and the anon public key
#   3. Authentication → URL Configuration → set Site URL to where you host
#      the app (http://localhost:5173 for local dev) so magic links land back
#      on the app.
# Every signed-in email appears under Authentication → Users — your leads.
# The anon key is safe to expose in the browser; it only grants public access.
# ─────────────────────────────────────────────────────────────────────────────
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# (older projects call the same key "anon" — VITE_SUPABASE_ANON_KEY works too)

# ─────────────────────────────────────────────────────────────────────────────
# The shell (OPTIONAL) — ops queue admin, audit lead capture, billing.
# ─────────────────────────────────────────────────────────────────────────────
# Server-only (NEVER VITE_-prefixed): lets /api/audit persist anonymous audit
# runs to the audits table as leads. Project Settings → API → service_role.
# On Vercel, also set SUPABASE_URL (or it falls back to VITE_SUPABASE_URL).
# SUPABASE_SERVICE_ROLE_KEY=

# Emails allowed to open the internal ops queue at /app#/admin (comma-sep).
# Routing only — real security is the admin RLS policies in
# supabase/2026-07-18_shell.sql (keep both lists in sync).
# VITE_ADMIN_EMAILS=you@example.com

# Paddle billing — with both set, the Operator upgrade card opens Paddle's
# overlay checkout (sandbox tokens work); unset, it's a contact-us CTA.
# VITE_PADDLE_CLIENT_TOKEN=
# VITE_PADDLE_PRICE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Shopify OAuth connect (OPTIONAL) — the deep audit.
#
# Create a (free) app at https://partners.shopify.com → Apps → Create app.
# App URL: your site origin. Allowed redirection URL(s):
#   https://<your-domain>/api/shopify-callback
#   http://localhost:5173/api/shopify-callback   (for dev)
# Then paste the app's credentials here (server-only, never VITE_-prefixed).
# Unset, the app simply hides the "Connect Shopify" card.
# ─────────────────────────────────────────────────────────────────────────────
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# Read-only by default; override only if you know why:
# SHOPIFY_SCOPES=read_products,read_orders,read_checkouts,read_customers
